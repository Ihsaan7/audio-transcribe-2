{
  "buildCommand": "vite build --config vite.config.ts",
  "outputDirectory": "dist/public",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "functions": {
    "api/transcribe.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
