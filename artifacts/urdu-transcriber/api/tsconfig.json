{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": false,
    "incremental": false,
    "composite": false,
    "allowImportingTsExtensions": false
  },
  "include": ["./**/*.ts"]
}